generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Shelf {
  WANT_TO_READ
  READING
  READ
  ABANDONED
}

enum ClubRole {
  OWNER
  MEMBER
}

enum DuelStatus {
  PENDING
  ACTIVE
  FINISHED
  DECLINED
  CANCELLED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String?
  yearlyGoal     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  books        UserBook[]
  memberships  ClubMembership[]
  ownedClubs   BookClub[]       @relation("ClubOwner")
  clubComments ClubComment[]
  resetTokens  PasswordResetToken[]

  duelsChallenged ReadingDuel[] @relation("DuelChallenger")
  duelsReceived   ReadingDuel[] @relation("DuelOpponent")
  duelsWon        ReadingDuel[] @relation("DuelWinner")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Book {
  id        String   @id @default(cuid())
  olid      String   @unique
  title     String
  author    String
  coverUrl  String?
  createdAt DateTime @default(now())

  userBooks   UserBook[]
  clubs       BookClub[]           @relation("CurrentBook")
  clubHistory ClubReadingHistory[]
  duels       ReadingDuel[]
}

model UserBook {
  id              String    @id @default(cuid())
  userId          String
  bookId          String
  shelf           Shelf
  addedAt         DateTime  @default(now())
  finishedAt      DateTime?
  pagesRead       Int?
  totalPages      Int?
  progressUpdated DateTime?
  rating          Int?
  ratedAt         DateTime?
  review          String?
  reviewUpdatedAt DateTime?
  notes           String?
  notesUpdatedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, shelf])
}

model BookClub {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  ownerId                String
  currentlyReadingBookId String?
  createdAt              DateTime @default(now())

  owner                User                 @relation("ClubOwner", fields: [ownerId], references: [id])
  currentlyReadingBook Book?                 @relation("CurrentBook", fields: [currentlyReadingBookId], references: [id])
  memberships          ClubMembership[]
  comments             ClubComment[]
  readingHistory       ClubReadingHistory[]
  duels                ReadingDuel[]
}

model ClubMembership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
}

model ClubReadingHistory {
  id        String    @id @default(cuid())
  clubId    String
  bookId    String
  startDate DateTime?
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  club BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  book Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([clubId, endedAt])
}

/// A head-to-head race between two readers on one book: whoever shelves it
/// as READ first wins. Scoped to the club the challenge was thrown in.
model ReadingDuel {
  id           String     @id @default(cuid())
  clubId       String
  bookId       String
  challengerId String
  opponentId   String
  status       DuelStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  respondedAt  DateTime?
  winnerId     String?
  wonAt        DateTime?

  club       BookClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  challenger User     @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User     @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  winner     User?    @relation("DuelWinner", fields: [winnerId], references: [id])

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([bookId, status])
}

model ClubComment {
  id        String   @id @default(cuid())
  clubId    String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())

  club    BookClub     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  ClubComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ClubComment[] @relation("CommentReplies")

  @@index([clubId, createdAt])
}
